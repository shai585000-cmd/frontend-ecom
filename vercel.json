{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-ecom-4mnz.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://backend-ecom-4mnz.onrender.com/media/:path*"
    },
    {
      "source": "/produits/:path*",
      "destination": "https://backend-ecom-4mnz.onrender.com/produits/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
